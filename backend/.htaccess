# Si el servidor apunta a la raiz del proyecto en lugar de a public/,
# esta regla evita exponer el codigo y redirige todo a public/.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Nada de este directorio debe servirse directamente.
<FilesMatch "\.(env|log|sql|md|json|lock|ini|sh|bak|old|php)$">
    Require all denied
</FilesMatch>
