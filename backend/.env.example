# ============================================================
#  PLATAFORMA ESTILO - Configuracion de entorno
#  Copia este archivo como .env y ajusta los valores.
#  NUNCA subas el .env real a un repositorio.
# ============================================================

# --- Aplicacion ---------------------------------------------
APP_NAME="Mi Barberia"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://mibarberia.com

# Genera la clave con: php cli/console.php key:generate
APP_KEY=

# Fuerza HTTPS (dejar en true cuando el dominio ya tenga certificado)
FORCE_HTTPS=true

# Activar SOLO si el sitio esta detras de un proxy o CDN de confianza
TRUST_PROXY=false
TRUSTED_PROXIES=

LOG_LEVEL=info

# --- Base de datos ------------------------------------------
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=estilo
DB_USERNAME=estilo_app
DB_PASSWORD=

# Conexion cifrada al motor (recomendado si la base esta en otro servidor)
DB_SSL=false
DB_SSL_CA=
DB_SSL_VERIFY=true

# --- Seguridad ----------------------------------------------
# Secreto adicional para las contrasenas. Cambiarlo invalida TODAS
# las contrasenas existentes, asi que se define una sola vez.
PASSWORD_PEPPER=
PASSWORD_MIN_LENGTH=10

# Secreto para firmar los tokens de la app movil (distinto de APP_KEY)
JWT_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

LOGIN_MAX_IP=20
LOGIN_MAX_ACCOUNT=8
LOGIN_DECAY=900
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_MINUTES=30

# Restringe el panel a estas IP (separadas por coma). Vacio = sin restriccion.
ADMIN_IP_ALLOWLIST=

# Roles obligados a usar verificacion en dos pasos
REQUIRE_2FA_ROLES=super_admin

# --- Sesion -------------------------------------------------
SESSION_NAME=estilo_sid
SESSION_LIFETIME=120
SESSION_ABSOLUTE_LIFETIME=720
SESSION_ROTATE=20
SESSION_SAME_SITE=Lax
SESSION_FORCE_SECURE=true
SESSION_BIND_IP=false

# --- Subida de archivos -------------------------------------
UPLOAD_MAX_BYTES=5242880
UPLOAD_IMAGE_QUALITY=82

# --- API movil ----------------------------------------------
API_ALLOWED_ORIGINS=
API_RATE_LIMIT=120,60
MIN_APP_VERSION=1.0.0

# --- Correo -------------------------------------------------
# transport: smtp | mail | log
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.tuproveedor.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@mibarberia.com
MAIL_FROM_NAME="Mi Barberia"
