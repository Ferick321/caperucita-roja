<?xml version="1.0" encoding="utf-8"?>
<!--
  Los tokens de sesion nunca salen del dispositivo: se excluyen de las copias
  de seguridad y de la transferencia entre telefonos.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage" />
    </device-transfer>
</data-extraction-rules>
